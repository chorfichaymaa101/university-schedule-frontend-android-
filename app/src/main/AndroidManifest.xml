<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- ADDED THE usesCleartextTraffic  TO BE ABLE TO HTPP AND NOT NECCESSARLY HTTPS-->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.FrontendMobile"
        tools:targetApi="31">
        <activity
            android:name=".ListProf"
            android:exported="false"
            android:theme="@style/Theme.FrontendMobile" />
        <activity
            android:name=".ModifyClass"
            android:exported="false" />
        <activity
            android:name=".AddClass"
            android:exported="false" />
        <activity
            android:name=".ModifyAdmin"
            android:exported="false" />
        <activity
            android:name=".AddAdmin"
            android:exported="false" />
        <activity
            android:name=".AddProf"
            android:exported="false" />
        <activity
            android:name=".ModifyProf"
            android:exported="false" />
        <activity
            android:name=".Login"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />

                <data
                    android:scheme="@string/appAuthRedirectScheme"
                android:host="oauth2redirect" />
            </intent-filter>
        </activity>
    </application>

</manifest>